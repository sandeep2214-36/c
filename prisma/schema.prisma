datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

enum Role {
  USER
  ADMIN
}

enum SyncStatus {
  IDLE
  SYNCING
  SUCCESS
  FAILED
}

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String    @unique
  emailVerified DateTime?
  image         String?
  role          Role      @default(USER)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  accounts      Account[]
  sessions      Session[]
  alerts        PriceAlert[]
  comparisons   Comparison[]
  searchHistory SearchHistory[]
  notifications Notification[]
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Category {
  id            String    @id @default(cuid())
  name          String    @unique
  slug          String    @unique
  description   String?
  image         String?
  parentId      String?
  parent        Category? @relation("SubCategories", fields: [parentId], references: [id])
  subCategories Category[] @relation("SubCategories")
  products      Product[]
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
}

model Product {
  id               String               @id @default(cuid())
  title            String
  brand            String
  model            String?
  modelNumber      String?
  sku              String?              @unique
  gtin             String?              @unique
  categoryId       String
  category         Category             @relation(fields: [categoryId], references: [id])
  description      String?              @db.Text
  images           String[]
  specifications   ProductSpecification[]
  variants         ProductVariant[]
  offers           Offer[]
  priceHistory     PriceHistory[]
  comparisons      ComparisonItem[]
  alerts           PriceAlert[]
  createdAt        DateTime             @default(now())
  updatedAt        DateTime             @updatedAt

  @@index([title])
  @@index([brand])
  @@index([modelNumber])
  @@index([categoryId])
}

model ProductVariant {
  id             String   @id @default(cuid())
  productId      String
  product        Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  name           String
  storage        String?
  ram            String?
  color          String?
  size           String?
  offers         Offer[]
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
}

model ProductSpecification {
  id        String   @id @default(cuid())
  productId String
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  key       String
  value     String
  group     String?

  @@index([productId])
}

model DataSource {
  id                    String     @id @default(cuid())
  name                  String     @unique
  slug                  String     @unique
  type                  String     // e.g. "API", "FEED", "DEMO"
  enabled               Boolean    @default(true)
  apiEndpoint           String?
  affiliateUrlTemplate  String?
  lastSync              DateTime?
  status                SyncStatus @id(map: "") @default(IDLE)
  rateLimit             Int        @default(60) // requests per minute
  configuration         Json?      
  offers                Offer[]
  syncLogs              SyncLog[]
  createdAt             DateTime   @default(now())
  updatedAt             DateTime   @updatedAt
}

model Seller {
  id          String   @id @default(cuid())
  name        String   @unique
  slug        String   @unique
  rating      Float?
  logo        String?
  offers      Offer[]
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model Offer {
  id              String         @id @default(cuid())
  productId       String
  product         Product        @relation(fields: [productId], references: [id], onDelete: Cascade)
  variantId       String?
  variant         ProductVariant? @relation(fields: [variantId], references: [id], onDelete: SetNull)
  dataSourceId    String
  dataSource      DataSource     @relation(fields: [dataSourceId], references: [id])
  sellerId        String
  seller          Seller         @relation(fields: [sellerId], references: [id])
  price           Float
  originalPrice   Float?
  discount        Float?
  currency        String         @default("INR")
  availability    Boolean        @default(true)
  deliveryInfo    String?
  rating          Float?
  reviewCount     Int?
  productUrl      String
  affiliateUrl    String?
  lastUpdated     DateTime       @default(now())
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt

  @@unique([productId, dataSourceId, sellerId, variantId])
  @@index([productId])
  @@index([price])
  @@index([dataSourceId])
  @@index([updatedAt])
}

model PriceHistory {
  id          String   @id @default(cuid())
  productId   String
  product     Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  price       Float
  source      String
  recordedAt  DateTime @default(now())

  @@index([productId])
  @@index([recordedAt])
}

model SearchHistory {
  id        String   @id @default(cuid())
  userId    String?
  user      User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  query     String
  createdAt DateTime @default(now())

  @@index([query])
}

model Comparison {
  id        String           @id @default(cuid())
  userId    String?
  user      User?            @relation(fields: [userId], references: [id], onDelete: SetNull)
  items     ComparisonItem[]
  createdAt DateTime         @default(now())
  updatedAt DateTime         @updatedAt
}

model ComparisonItem {
  id           String     @id @default(cuid())
  comparisonId String
  comparison   Comparison @relation(fields: [comparisonId], references: [id], onDelete: Cascade)
  productId    String
  product      Product    @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([comparisonId, productId])
}

model PriceAlert {
  id          String   @id @default(cuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  productId   String
  product     Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  targetPrice Float
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([userId])
  @@index([productId])
}

model Notification {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  title     String
  message   String
  isRead    Boolean  @default(false)
  createdAt DateTime @default(now())

  @@index([userId])
}

model SyncJob {
  id           String     @id @default(cuid())
  sourceId     String
  status       SyncStatus @default(IDLE)
  itemsSynced  Int        @default(0)
  errorDetails String?    @db.Text
  startedAt    DateTime   @default(now())
  completedAt  DateTime?
}

model SyncLog {
  id           String     @id @default(cuid())
  dataSourceId String
  dataSource   DataSource @relation(fields: [dataSourceId], references: [id], onDelete: Cascade)
  message      String
  level        String     // INFO, WARN, ERROR
  createdAt    DateTime   @default(now())
}
